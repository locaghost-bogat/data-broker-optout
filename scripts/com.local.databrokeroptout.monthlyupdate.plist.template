<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reference copy of the launchd agent. The installer (dbopt.cli install-monthly)
  writes a version of this with absolute paths filled in to
  ~/Library/LaunchAgents/com.local.databrokeroptout.monthlyupdate.plist

  Only Day/Hour/Minute are pinned, so launchd fires it once per month.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.databrokeroptout.monthlyupdate</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>dbopt.cli</string>
        <string>update</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>__REPO_ROOT__</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Day</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>10</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/../launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/../launchd.err.log</string>
</dict>
</plist>
